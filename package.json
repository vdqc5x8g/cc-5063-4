{
  "name": "surface-stitch-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Parametric surface stitching workbench with continuity solving, seam error analysis and analytic export",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "experiments": "tsx scripts/experiments.ts",
    "experiments:check": "tsx scripts/experiments.ts --check"
  },
  "dependencies": {
    "ml-matrix": "^6.15.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
